PORT=3001
# Set NODE_ENV=production for deployment (Docker already does).
# Production requires an explicit PUBLIC_URL, HTTPS and COOKIE_SECURE=true.
# Loopback HTTP with COOKIE_SECURE=false is allowed for local production tests.
# Development binds to loopback. Set HOST=0.0.0.0 for container access.
# Public, permanent origin encoded into dynamic QR codes. No trailing slash.
PUBLIC_URL=http://localhost:5173
# Only true/false are accepted. HTTPS production requires true.
COOKIE_SECURE=false
# A persistent directory; never commit database files.
DATA_DIR=./data
# Behind one trusted reverse proxy, set TRUST_PROXY=1. Otherwise leave unset or use 0.
# Automatic database + media snapshots, measured from server startup. Set to 0 to disable.
BACKUP_INTERVAL_HOURS=24
# Number of archives kept in DATA_DIR/backups. Copy backups off the server separately.
BACKUP_RETENTION=7
# Optional hosted service mode. Self-hosted stays complete with no QR/team plan caps.
# HOSTED_MODE=false
# HOSTED_MAX_OWNED_WORKSPACES=3
# Public plans: Free, Plus and Pro. Plus/Pro are coming soon; prices and checkout are hidden.
# Super Admins grant account access, including Unlimited, under Control room > Billing.
# Legacy PLAN_CREATOR_MONTHLY_INR / PLAN_BUSINESS_MONTHLY_INR remain accepted but are not displayed.
# Optional restore-only limit for total uncompressed bytes (default 1 GiB).
# RESTORE_MAX_BYTES=1073741824
# Per-workspace media quota and per-file upload limit, in MB.
# WORKSPACE_STORAGE_MB=1024
# MAX_UPLOAD_MB=100
# Optional private S3-compatible media storage (move existing files with npm run storage:sync).
# S3_BUCKET=
# S3_PREFIX=openqr/media/
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false
# Optional off-server backup copies.
# S3_BACKUP_BUCKET=
# S3_BACKUP_PREFIX=openqr/backups/
# Optional support alerts (no request text is ever included in a notification).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=OpenQR <support@example.com>
# SUPPORT_ALERT_EMAIL=support@example.com,billing@example.com
# SUPPORT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Optional: sign webhook calls. Receivers verify HMAC-SHA256 of "<x-openqr-timestamp>.<body>"
# against the x-openqr-signature header (sha256=<hex>). At least 16 characters.
# SUPPORT_WEBHOOK_SECRET=
# One JSON line per request (route template, status, duration; no addresses or queries).
# Defaults to true in production and false otherwise.
# LOG_REQUESTS=true
