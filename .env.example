PORT=3001
# Development binds to loopback. Set HOST=0.0.0.0 for container access.
# Public, permanent origin encoded into dynamic QR codes. No trailing slash.
PUBLIC_URL=http://localhost:5173
# Set to true only when served over HTTPS.
COOKIE_SECURE=false
# A persistent directory; never commit database files.
DATA_DIR=./data
# Behind one trusted reverse proxy, set TRUST_PROXY=1. Otherwise leave unset.
