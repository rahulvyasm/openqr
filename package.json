{
  "name": "openqr",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host localhost\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "test:recovery": "node --test test/recovery.test.js",
    "format": "prettier --write src server shared scripts test *.json *.ts *.md *.yaml .github/workflows/*.yml",
    "recover": "node server/manage.js",
    "operator": "node server/operator-cli.js",
    "backup": "node server/backup-cli.js backup",
    "restore": "node server/backup-cli.js restore",
    "predev": "node scripts/pdf-assets.js",
    "prebuild": "node scripts/pdf-assets.js",
    "storage:sync": "node server/storage-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.62.0",
    "music-metadata": "^12.3.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
