{
  "name": "openqr",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host localhost\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "deploy:supabase": "node scripts/deploy-supabase.mjs",
    "test:hosted": "npm run build:hosted && node scripts/test-hosted.mjs",
    "test:recovery": "node --test test/recovery.test.js",
    "test:visual": "npm run build && playwright test",
    "dev:lite": "vite -c vite.lite.config.ts",
    "build:lite": "vite build -c vite.lite.config.ts",
    "build:hosted": "node scripts/pdf-assets.js && tsc --noEmit && vite build -c vite.hosted.config.ts && node scripts/prepare-hosted.mjs",
    "test:e2e": "npm run build:lite && playwright test -c playwright.e2e.config.js",
    "docs:screenshots": "npm run build && playwright test -c playwright.docs.config.js",
    "test:visual:update": "npm run build && playwright test --update-snapshots",
    "format": "prettier --write src server shared scripts test *.json *.ts *.md *.yaml .github/workflows/*.yml",
    "recover": "node server/manage.js",
    "operator": "node server/operator-cli.js",
    "backup": "node server/backup-cli.js backup",
    "restore": "node server/backup-cli.js restore",
    "predev": "node scripts/pdf-assets.js",
    "prebuild": "node scripts/pdf-assets.js",
    "storage:sync": "node server/storage-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "file-type": "^22.2.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "jpeg-js": "0.4.4",
    "lucide-react": "^1.62.0",
    "music-metadata": "^12.3.2",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pngjs": "7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.156.0"
  }
}
